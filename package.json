{
  "name": "grabby",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/onest": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native/normalize-colors": "^0.88.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.108.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.13",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "node-html-parser": "^9.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.8.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "windows-1251": "^3.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "theme": "bun scripts/gen-theme.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:e2e": "maestro test .maestro",
    "theme:check": "bun scripts/gen-theme.ts --check",
    "build:apk": "eas build --platform android --profile preview"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/android",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/",
      "/android/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|windows-1251)"
    ]
  }
}
